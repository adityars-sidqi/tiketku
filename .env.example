# Local development settings for TiketKu.
# Copy to .env (git-ignored) and adjust. Never commit real secrets.
#   cp .env.example .env
# All credentials below are dev placeholders for local containers only.

# --- PostgreSQL ---
POSTGRES_IMAGE_TAG=17.11-alpine
POSTGRES_PORT=5432
POSTGRES_USER=tiketku
POSTGRES_PASSWORD=tiketku_dev_password

# --- Redis ---
REDIS_IMAGE_TAG=7.4.7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=tiketku_dev_password

# --- Kafka (KRaft, single broker) ---
KAFKA_IMAGE_TAG=4.4.0
# Host listener port; advertised as localhost:<port>.
KAFKA_PORT=9092
# Fixed cluster ID (22-char base64 UUID) so the data volume survives restarts.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Kafka UI (optional, compose profile "tools") ---
KAFKA_UI_IMAGE_TAG=v1.5.0
KAFKA_UI_PORT=8090

# --- RabbitMQ ---
RABBITMQ_IMAGE_TAG=4.3.7-management-alpine
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=tiketku
RABBITMQ_PASSWORD=tiketku_dev_password
RABBITMQ_VHOST=tiketku

# --- Mailpit ---
MAILPIT_IMAGE_TAG=v1.32.0
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Jaeger ---
JAEGER_IMAGE_TAG=2.22.0
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
