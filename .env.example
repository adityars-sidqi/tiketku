# Local development settings for TiketKu.
# Copy to .env (git-ignored) and adjust. Never commit real secrets.
#   cp .env.example .env
# All credentials below are dev placeholders for local containers only.

# --- PostgreSQL ---
POSTGRES_IMAGE_TAG=17.11-alpine
POSTGRES_PORT=5432
POSTGRES_USER=tiketku
POSTGRES_PASSWORD=tiketku_dev_password

# --- Redis ---
REDIS_IMAGE_TAG=7.4.7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=tiketku_dev_password

# --- Kafka (KRaft, single broker) ---
KAFKA_IMAGE_TAG=4.4.0
# Host listener port; advertised as localhost:<port>.
KAFKA_PORT=9092
# Fixed cluster ID (22-char base64 UUID) so the data volume survives restarts.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Kafka UI (optional, compose profile "tools") ---
KAFKA_UI_IMAGE_TAG=v1.5.0
KAFKA_UI_PORT=8090

# --- RabbitMQ ---
RABBITMQ_IMAGE_TAG=4.3.7-management-alpine
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=tiketku
RABBITMQ_PASSWORD=tiketku_dev_password
RABBITMQ_VHOST=tiketku

# --- Mailpit ---
MAILPIT_IMAGE_TAG=v1.32.0
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Jaeger ---
JAEGER_IMAGE_TAG=2.22.0
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# =====================================================================
# Services (story #4). Each service reads only its own <PREFIX>_* vars,
# so all five can run side by side from this one file.
# HTTP ports default to 8081-8085 when unset.
# =====================================================================

# --- auth-service ---
AUTH_HTTP_PORT=8081
AUTH_DATABASE_URL=postgres://tiketku:tiketku_dev_password@localhost:5432/auth_db
AUTH_REDIS_URL=redis://:tiketku_dev_password@localhost:6379/0
AUTH_KAFKA_BROKERS=localhost:9092

# --- catalog-service ---
CATALOG_HTTP_PORT=8082
CATALOG_DATABASE_URL=postgres://tiketku:tiketku_dev_password@localhost:5432/catalog_db
CATALOG_REDIS_URL=redis://:tiketku_dev_password@localhost:6379/1
CATALOG_KAFKA_BROKERS=localhost:9092

# --- order-service ---
ORDER_HTTP_PORT=8083
ORDER_DATABASE_URL=postgres://tiketku:tiketku_dev_password@localhost:5432/order_db
ORDER_REDIS_URL=redis://:tiketku_dev_password@localhost:6379/2
ORDER_KAFKA_BROKERS=localhost:9092
ORDER_RABBITMQ_URL=amqp://tiketku:tiketku_dev_password@localhost:5672/tiketku

# --- payment-service ---
PAYMENT_HTTP_PORT=8084
PAYMENT_DATABASE_URL=postgres://tiketku:tiketku_dev_password@localhost:5432/payment_db
PAYMENT_KAFKA_BROKERS=localhost:9092

# --- notification-service ---
NOTIFICATION_HTTP_PORT=8085
NOTIFICATION_DATABASE_URL=postgres://tiketku:tiketku_dev_password@localhost:5432/notification_db
NOTIFICATION_KAFKA_BROKERS=localhost:9092
NOTIFICATION_RABBITMQ_URL=amqp://tiketku:tiketku_dev_password@localhost:5672/tiketku
